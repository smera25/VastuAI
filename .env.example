# Copy to .env (never commit .env). Real environment variables override this file.

# ---------------- CORS ----------------
# The Vite dev server is allowed by default (localhost / 127.0.0.1 / private LAN ranges on any port).
# Add your deployed frontend origin(s) here, comma-separated:
# CORS_ORIGINS=https://your-frontend.example.com

# ---------------- Image generation (redesign visualization) ----------------
# IMAGE_PROVIDER=auto|openai|gemini|none   (auto = whichever key is present, OpenAI first)
IMAGE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_TIMEOUT_SECONDS=180

# ---------------- VGGT ----------------
# auto = use VGGT when torch + weights are available; false = never use it
VGGT_ENABLED=auto
VGGT_MODEL_ID=facebook/VGGT-1B
# Offline use: point to a downloaded model.pt / model.safetensors instead of Hugging Face
# VGGT_WEIGHTS_PATH=
VGGT_DEVICE=auto          # auto | cpu | cuda
VGGT_MAX_IMAGES=8         # CPU inference is slow; photos beyond this are subsampled (photo 1 is always kept)

# ---------------- Limits / misc ----------------
# MAX_IMAGE_BYTES=10485760
# MAX_ROOM_IMAGES=12
# VASTU_RULES_FILE=./config/vastu_rules.json   # override / disable individual rules (see README)
# LOG_LEVEL=INFO
