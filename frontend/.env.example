# Copy to .env.local. Base URL of the FastAPI backend (no trailing slash).
# Local development with the backend on the same machine:
VITE_API_BASE_URL=http://localhost:8000
# Testing from a phone on the same Wi-Fi: use your computer's LAN address instead, e.g.
# VITE_API_BASE_URL=http://192.168.1.20:8000   (and start the backend with --host 0.0.0.0)
